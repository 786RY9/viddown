{
  "name": "@viddown/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "fetch-sidecars": "node scripts/fetch-sidecars.mjs",
    "dev": "node scripts/fetch-sidecars.mjs && tauri dev",
    "build": "node scripts/fetch-sidecars.mjs && tauri build",
    "build:release": "node scripts/fetch-sidecars.mjs && tauri build --config src-tauri/tauri.release.conf.json",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "description": "viddown desktop shell (Tauri 2) running the Expo web UI with local yt-dlp + ffmpeg"
}
