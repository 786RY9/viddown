# viddown server configuration (environment variables).
# On the server this lives at /etc/viddown/viddown.env (install.sh generates it from
# this file). Every commented line shows the built-in default.

# ── required ────────────────────────────────────────────────────────────────
# HMAC key for stream tokens. install.sh fills in 64 random hex chars.
VIDDOWN_SECRET=
VIDDOWN_PUBLIC_BASE_URL=https://CHANGE-ME.duckdns.org
VIDDOWN_HOST=127.0.0.1
VIDDOWN_PORT=8000
# Operator-edited JSON merged into /v1/manifest (app versions, notices, kill switches).
VIDDOWN_MANIFEST_BASE=/etc/viddown/manifest.json
# ntfy.sh topic for "hire me" contact-form pushes (empty = off).
VIDDOWN_NTFY_TOPIC=

# ── network ─────────────────────────────────────────────────────────────────
# Peers whose X-Forwarded-For is believed (Caddy on localhost).
# VIDDOWN_TRUSTED_PROXIES=127.0.0.1,::1
# VIDDOWN_NTFY_URL=https://ntfy.sh

# ── paths (systemd sets RUNTIME_DIRECTORY/STATE_DIRECTORY; these are fallbacks) ─
# VIDDOWN_RUNTIME_DIR=/tmp/viddown        # FIFOs + per-job dirs; must be tmpfs in production
# VIDDOWN_STATE_DIR=./state               # viddown.db, validated.json

# ── resource budget (see viddown_server/resources.py) ─────────────────────────
# budget = min(RAM - RESERVED_MB, cgroup memory.high/max) - BASE_MB
# VIDDOWN_RESERVED_MB=1500                # OS + Caddy + SSH headroom
# VIDDOWN_BASE_MB=200                     # the API process itself
# VIDDOWN_EXTRACT_MB=150                  # per pre-warmed yt-dlp worker
# VIDDOWN_STREAM_MB=180                   # per stream (2x yt-dlp + ffmpeg -c copy)
# VIDDOWN_TRANSCODE_MB=400                # per precise-clip re-encode
# VIDDOWN_STREAMS_PER_CPU=15
# VIDDOWN_NET_STREAM_CAP=40               # absolute stream cap (network share)
# Hard overrides (empty = computed from the machine):
# VIDDOWN_EXTRACT_WORKERS=
# VIDDOWN_STREAM_SLOTS=
# VIDDOWN_TRANSCODE_SLOTS=
# VIDDOWN_MAX_WAITERS=32                  # queued requests per job class
# VIDDOWN_QUEUE_WAIT_S=20                 # then 503 + Retry-After

# ── per-client limits (client IPs are kept in memory only, never stored) ─────
# VIDDOWN_PROBE_RATE_PER_MIN=20
# VIDDOWN_PROBE_BURST=20
# VIDDOWN_STREAM_RATE_PER_MIN=10
# VIDDOWN_MAX_STREAMS_PER_IP=2
# VIDDOWN_CONTACT_RATE_PER_HOUR=5
# VIDDOWN_PING_RATE_PER_HOUR=60

# ── memory-pressure guard (every 2 s: PSI + MemAvailable) ────────────────────
# VIDDOWN_PRESSURE_INTERVAL_S=2
# VIDDOWN_PSI_SOME_PRESSURE=10            # some avg10 % -> stop admitting
# VIDDOWN_PSI_FULL_CRITICAL=5             # full avg10 % -> cancel newest transcode/stream
# VIDDOWN_MEM_LOW_MB=800
# VIDDOWN_MEM_CRITICAL_MB=300

# ── egress budget (OCI Always Free includes 10 TB/month outbound; verify in console) ─
# VIDDOWN_EGRESS_CUTOFF_TB=8              # manifest cloud.enabled=false beyond this
# VIDDOWN_CLOUD_ENABLED=true              # master switch for probe/stream

# ── extraction ──────────────────────────────────────────────────────────────
# yt-dlp extractor names (yt-dlp --list-extractors), full-match regexes, comma separated.
# The generic extractor is always disabled.
# VIDDOWN_ALLOWED_EXTRACTORS=youtube,youtube:clip,instagram,tiktok,twitter,reddit,vimeo,facebook,facebook:reel,dailymotion,streamable,bluesky,twitch:clips,soundcloud
# VIDDOWN_PROBE_CACHE_SIZE=256
# VIDDOWN_PROBE_CACHE_TTL_S=600
# VIDDOWN_EXTRACT_TIMEOUT_S=45
# VIDDOWN_MAX_TASKS_PER_CHILD=50
# VIDDOWN_MAX_HEIGHT=1080
# VIDDOWN_MAX_DURATION_S=10800

# ── streaming ───────────────────────────────────────────────────────────────
# VIDDOWN_TOKEN_TTL_S=600
# VIDDOWN_STALL_TIMEOUT_S=60              # no bytes in/out for this long -> kill job
# VIDDOWN_MAX_STREAM_GB=2
# VIDDOWN_MAX_STREAM_HOURS=3
# VIDDOWN_CHUNK_SIZE=65536
# VIDDOWN_FFMPEG=ffmpeg                   # systemd points this at the slot's ffmpeg
# VIDDOWN_YTDLP_CMD=                      # default: "<this python> -m yt_dlp"
# VIDDOWN_DRAIN_TIMEOUT_S=300             # graceful drain on SIGTERM

# VIDDOWN_LOG_LEVEL=INFO

# ── TEST ONLY: never enable in production ───────────────────────────────────
# VIDDOWN_UNSAFE_ALLOW_GENERIC=false      # enables yt-dlp's generic extractor
# VIDDOWN_UNSAFE_ALLOW_PRIVATE_URLS=false # disables the SSRF address check
