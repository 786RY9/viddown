# viddown: repository-wide ignore rules.
# Security first: secrets must never reach git. If a rule here blocks a file
# you really need to commit, add a narrow `!path` exception with a comment.

# ═══════════════════════════════════════════════════════════════════════════
# Secrets and credentials (keep this section at the top)
# ═══════════════════════════════════════════════════════════════════════════

# Environment files: only the documented templates are committed.
.env
.env.*
*.env
!.env.example
!**/.env.example
!*.env.example

# Private keys and certificates (SSH, TLS, Apple, generic)
*.key
*.pem
*.p8
*.p12
*.pfx
*.cer
*.crt
*.der
*.csr
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ed25519
oracle_*
ssh-key-*
known_hosts*
authorized_keys

# Android signing
*.jks
*.keystore
keystore.properties
signing.properties
release-signing.*
google-services.json
# Apple signing / provisioning
*.mobileprovision
*.provisionprofile
GoogleService-Info.plist
AuthKey_*.p8

# Tauri updater signing key (the .pub half is safe and is committed in tauri.conf.json)
*.key.pub.priv
viddown.key
tauri-signing*.key
.tauri/

# Cloud and service credentials
.oci/
oci_api_key*
*.ociconfig
credentials
credentials.json
*credentials*.json
service-account*.json
client_secret*.json
.aws/
.netrc
.npmrc
.pypirc
cookies.txt
*cookies*.txt
.vercel/
.secrets/
secrets/
*.secret
*.secrets

# Server deploy config written on the VM (domain, DuckDNS token, ntfy topic,
# backup URL). Templates live in server/deploy/ and server/.env.example.
deploy.env
viddown.env
caddy.env

# ═══════════════════════════════════════════════════════════════════════════
# Runtime data (may contain users' emails, IP-derived counters, logs)
# ═══════════════════════════════════════════════════════════════════════════
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Server runtime state (SQLite, egress counters). Anchored: apps/mobile/src/state is source code.
server/state/
/state/
*.log
logs/
loadtest/results/

# Downloaded media and partial downloads (the CLI and test runs)
downloads/
*.part
*.ytdl
*.mp4
*.mkv
*.webm
*.mp3
*.m4a
*.opus
*.wav
*.mov

# Server bundles produced by scripts/build_bundle.py
viddown-server-*.tar.gz
viddown-server-*.tar.gz.sha256
*.tgz

# ═══════════════════════════════════════════════════════════════════════════
# Dependencies and build output
# ═══════════════════════════════════════════════════════════════════════════

# Node / pnpm
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
coverage/
.turbo/

# Expo / React Native (native folders are generated: Continuous Native Generation)
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
apps/mobile/android/
apps/mobile/ios/
.kotlin/
*.orig.*

# Gradle / Android build output (incl. local Expo modules)
.gradle/
build/
.cxx/
local.properties
*.apk
*.aab
*.ap_
*.dex
captures/

# Rust / Tauri
target/
apps/desktop/src-tauri/gen/schemas/
apps/desktop/src-tauri/binaries/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
# Vendored copy of cli/viddown_core, regenerated at build time
server/viddown_core/

# Docker
.dockerenv

# ═══════════════════════════════════════════════════════════════════════════
# Tooling, editors, OS
# ═══════════════════════════════════════════════════════════════════════════
.playwright-mcp/
playwright-report/
test-results/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
